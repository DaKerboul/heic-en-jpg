---
import { SITE_NAME, SITE_URL, NAV_LINKS } from '../lib/site';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
}
const { title, description, canonical, ogImage = '/og-image.svg', noindex = false } = Astro.props;
const url = canonical ?? `${SITE_URL}${Astro.url.pathname}`;
// Ancres : sur l'accueil on scrolle en place, ailleurs on revient d'abord à l'accueil
// (sinon le CTA "Convertir" paraît mort sur /confidentialite/ et consorts).
const onHome = Astro.url.pathname === '/';
const convHref = onHome ? '#convertisseur' : '/#convertisseur';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#059669" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={`${SITE_URL}${ogImage}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": SITE_NAME,
      "applicationCategory": "MultimediaApplication",
      "operatingSystem": "Web",
      "offers": { "@type": "Offer", "price": "0", "priceCurrency": "EUR" },
      "description": description,
    })} />
    <script>
      // Thème appliqué avant peinture (évite le flash) : choix sauvé > système.
      try {
        const saved = localStorage.getItem('conv-theme');
        if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        }
      } catch { /* ignore */ }
    </script>
  </head>
  <body class="min-h-screen bg-gradient-to-b from-slate-50 via-white to-slate-50 font-sans text-slate-900 antialiased dark:from-slate-950 dark:via-slate-900 dark:to-slate-950 dark:text-slate-100">
    <a href={convHref} class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-lg focus:bg-emerald-600 focus:px-4 focus:py-2 focus:text-white">
      Aller au convertisseur
    </a>
    <header class="sticky top-0 z-40 border-b border-slate-200/70 bg-white/85 backdrop-blur-md dark:border-slate-700/70 dark:bg-slate-900/85">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
        <a href="/" class="flex items-center gap-2.5" aria-label="Accueil Convertisseur Local">
          <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-lg font-black text-white shadow-md" aria-hidden="true">⇄</span>
          <span class="leading-tight">
            <span class="block text-[15px] font-extrabold tracking-tight">Convertisseur <span class="text-emerald-600 dark:text-emerald-400">Local</span></span>
            <span class="block text-[11px] font-medium text-slate-500 dark:text-slate-400">HEIC · WebP → JPG / PDF · 100% privé</span>
          </span>
        </a>
        <nav class="hidden items-center gap-1 text-sm font-medium md:flex" aria-label="Navigation principale">
          {NAV_LINKS.map((l) => (
            <a href={l.href} class="rounded-lg px-3 py-2 text-slate-600 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white">{l.label}</a>
          ))}
          <button id="theme-toggle" class="rounded-lg p-2 text-slate-500 transition hover:bg-slate-100 hover:text-slate-900 dark:text-slate-300 dark:hover:bg-slate-800 dark:hover:text-white" aria-label="Basculer mode sombre / clair" title="Mode sombre / clair">
            <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 17a5 5 0 100-10 5 5 0 000 10zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" /></svg>
          </button>
          <a href={convHref} class="ml-2 rounded-xl bg-slate-900 px-4 py-2 font-semibold text-white shadow-sm transition hover:bg-slate-700 dark:bg-emerald-600 dark:hover:bg-emerald-500">Convertir</a>
        </nav>
        <span class="flex items-center gap-2 md:hidden">
          <button id="theme-toggle-m" class="rounded-lg p-2 text-slate-500 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-slate-800" aria-label="Basculer mode sombre / clair">
            <svg class="hidden h-5 w-5 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M12 17a5 5 0 100-10 5 5 0 000 10zM12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="h-5 w-5 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z" /></svg>
          </button>
          <a href={convHref} class="rounded-xl bg-slate-900 px-4 py-2 text-sm font-semibold text-white dark:bg-emerald-600">Convertir</a>
        </span>
      </div>
    </header>

    <main class="mx-auto max-w-6xl px-4 pb-16">
      <slot />
    </main>

    <footer class="border-t border-slate-200 bg-slate-950 text-slate-300 dark:border-slate-800">
      <div class="mx-auto grid max-w-6xl gap-8 px-4 py-12 sm:grid-cols-4">
        <div class="sm:col-span-2">
          <p class="flex items-center gap-2 text-lg font-extrabold text-white"><span class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500 text-base" aria-hidden="true">⇄</span> Convertisseur Local</p>
          <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-400">
            Convertissez HEIC, WebP, PNG et JPG en fichiers universels directement dans votre navigateur.
            Aucun compte, aucun envoi serveur : vos photos ne quittent jamais votre appareil.
          </p>
          <p class="mt-3 inline-flex items-center gap-1.5 rounded-full bg-emerald-500/10 px-3 py-1 text-xs font-semibold text-emerald-300">
            <span aria-hidden="true">🔒</span> 100% local · vérifiable hors-ligne
          </p>
        </div>
        <nav aria-label="Convertisseurs">
          <p class="text-sm font-bold uppercase tracking-wider text-slate-500">Convertisseurs</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="hover:text-white hover:underline" href="/convertir-heic-en-jpg/">HEIC → JPG</a></li>
            <li><a class="hover:text-white hover:underline" href="/convertir-webp-en-pdf/">WebP → PDF</a></li>
            <li><a class="hover:text-white hover:underline" href="/reduire-photo-moins-2mo/">Réduire sous 2 Mo</a></li>
            <li><a class="hover:text-white hover:underline" href="/">Tous les formats</a></li>
          </ul>
        </nav>
        <nav aria-label="Informations">
          <p class="text-sm font-bold uppercase tracking-wider text-slate-500">Informations</p>
          <ul class="mt-3 space-y-2 text-sm">
            <li><a class="hover:text-white hover:underline" href="/confidentialite/">Confidentialité</a></li>
            <li><a class="hover:text-white hover:underline" href="/mentions-legales/">Mentions légales</a></li>
            <li><a class="hover:text-white hover:underline" href="/#faq">Questions fréquentes</a></li>
            <li><a class="hover:text-white hover:underline" href="/#avis">Signaler un problème</a></li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-white/10">
        <p class="mx-auto max-w-6xl px-4 py-4 text-xs text-slate-500">© {new Date().getFullYear()} Convertisseur Local — outil gratuit, sans compte, sans envoi de fichiers.</p>
      </div>
    </footer>

    <script>
      // Thème : toggle + persistance (clé partagée avec le script anti-flash du <head>).
      const toggleTheme = () => {
        const dark = document.documentElement.classList.toggle('dark');
        try {
          localStorage.setItem('conv-theme', dark ? 'dark' : 'light');
        } catch { /* ignore */ }
      };
      document.getElementById('theme-toggle')?.addEventListener('click', toggleTheme);
      document.getElementById('theme-toggle-m')?.addEventListener('click', toggleTheme);
    </script>
    <script>
      // PWA offline : mise en cache runtime (shell + WASM) après 1re visite.
      if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost')) {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {});
        });
      }
    </script>
  </body>
</html>
