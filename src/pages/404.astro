---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page introuvable — Convertisseur Local" description="Cette page n’existe pas. Retournez au convertisseur HEIC & WebP." noindex={true}>
  <section class="py-16 text-center">
    <p class="text-6xl font-black text-slate-200 dark:text-slate-700" aria-hidden="true">404</p>
    <h1 class="mt-2 text-3xl font-black tracking-tight">Cette page n’existe pas</h1>
    <p class="mx-auto mt-2 max-w-md text-slate-600 dark:text-slate-300">Le convertisseur, lui, existe bel et bien — et vos fichiers n’ont pas besoin de cette page pour être convertis.</p>
    <a href="/" class="mt-6 inline-block rounded-2xl bg-slate-900 px-6 py-3 font-bold text-white hover:bg-slate-700">Retour au convertisseur</a>
  </section>
</BaseLayout>
