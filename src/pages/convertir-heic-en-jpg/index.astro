---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PrivacyBadge from '../../components/PrivacyBadge.astro';
import Faq from '../../components/Faq.astro';
import FeedbackForm from '../../components/FeedbackForm.astro';
import ConverterIsland from '../../components/ConverterIsland';

const faqs = [
  { q: 'Comment convertir une photo HEIC d’iPhone en JPG ?', a: 'Déposez le fichier .heic dans le convertisseur ci-dessus, laissez « JPG universel » sélectionné, cliquez « Convertir ». Le JPG se télécharge ensuite, accepté partout : ANTS, CAF, Ameli, recruteurs, imprimeurs.' },
  { q: 'Le JPG sera-t-il sous 2 Mo ?', a: 'Sélectionnez le preset « ANTS / Ameli / CAF (< 2 Mo) » : l’outil baisse progressivement qualité (90 → 55 %) et dimensions (jusqu’à 960 px) jusqu’à passer sous le seuil. Le gain réalisé s’affiche par fichier.' },
  { q: 'Puis-je convertir plusieurs HEIC d’un coup ?', a: 'Oui, jusqu’à 10 par lot, puis « Tout télécharger en ZIP ». La conversion est séquentielle pour ne pas saturer la mémoire de votre téléphone ou ordinateur.' },
  { q: 'Windows ne lit pas mes HEIC, que faire ?', a: 'C’est le cas le plus courant : convertissez ici en JPG depuis n’importe quel navigateur, sans installer de codec ni d’application.' },
];
---
<BaseLayout
  title="Convertir HEIC en JPG — photo iPhone pour ANTS, CAF, emploi"
  description="Transformez vos photos iPhone .heic en JPG universel accepté par ANTS, CAF, Ameli et les recruteurs. Gratuit, 100% local, batch + réduction auto sous 2 Mo."
>
  <nav class="pt-6 text-xs text-slate-400" aria-label="Fil d’Ariane"><a href="/" class="hover:underline">Accueil</a> / Convertir HEIC en JPG</nav>
  <h1 class="mt-2 max-w-3xl text-3xl font-black tracking-tight sm:text-4xl">Convertir HEIC en JPG <span class="text-emerald-600">sans rien installer</span></h1>
  <p class="mt-3 max-w-2xl text-slate-600 dark:text-slate-300">
    Depuis iOS 11, l’iPhone enregistre en <strong>.heic</strong> : deux fois plus léger que le JPG, mais refusé par la plupart des portails français.
    Cet outil décode vos photos <strong>dans votre navigateur</strong> (WebAssembly libheif) et les ré-encode en JPG universel — sans compte, sans envoi.
  </p>

  <section id="convertisseur" class="mt-6 scroll-mt-24">
    <PrivacyBadge />
    <div class="mt-4"><ConverterIsland client:visible /></div>
  </section>

  <section class="mt-10 grid gap-6 border-y border-slate-200 py-6 dark:border-slate-700 sm:grid-cols-3 sm:divide-x sm:divide-slate-200 sm:dark:divide-slate-700">
    {[
      { t: 'Démarches ANTS', d: 'Permis, carte d’identité, passeport : JPG + preset < 2 Mo, accepté du premier coup.' },
      { t: 'Candidatures', d: 'CV photo, LinkedIn, portfolios : JPG léger qui s’ouvre sur tous les ATS de recrutement.' },
      { t: 'CAF, Ameli, impôts', d: 'Justificatifs et pièces jointes : fini le « format de fichier non pris en charge ».' },
    ].map((c) => (
      <div class="sm:px-6 first:sm:pl-0 last:sm:pr-0"><p class="font-extrabold">{c.t}</p><p class="mt-1 text-sm text-slate-600 dark:text-slate-300">{c.d}</p></div>
    ))}
  </section>

  <section class="mt-10 rounded-3xl border border-slate-200 bg-white p-6 shadow-sm dark:border-slate-700 dark:bg-slate-800">
    <h2 class="text-xl font-extrabold">Pas à pas : photo iPhone → dossier accepté</h2>
    <ol class="mt-3 list-decimal space-y-1.5 pl-5 text-sm text-slate-700 dark:text-slate-300">
      <li>Sur iPhone, retrouvez la photo dans <em>Photos → Partager → Enregistrer dans Fichiers</em> (elle reste en .heic).</li>
      <li>Déposez-la ici, vérifiez le preset <em>ANTS / Ameli / CAF</em>.</li>
      <li>Cliquez <em>Convertir</em>, contrôlez le poids affiché (ex : 3,1 Mo → 780 Ko), téléchargez.</li>
      <li>Versez le JPG dans le formulaire administratif : il passe la validation d’extension <em>et</em> de taille.</li>
    </ol>
  </section>

  <Faq title="HEIC → JPG : questions fréquentes" items={faqs} />
  <FeedbackForm />
</BaseLayout>
